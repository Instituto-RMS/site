# Copie este arquivo para `.env.local` na raiz do repositório e edite com seus valores.
# `.env.local` é gitignored — nunca será commitado.
#
# Exemplos de uso:
#   - Apontar para um banco de dados de teste/staging no Notion.
#   - Usar um token pessoal diferente do token de CI.
#   - Sobrescrever apenas uma das databases sem mexer no `.env` compartilhado.
#
# export NOTION_TOKEN=secret_seu_token_local
# export NOTION_PROJECTS_DB_ID=uuid_local_projetos
# export NOTION_EVENTS_DB_ID=uuid_local_eventos
